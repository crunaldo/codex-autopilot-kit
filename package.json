{
  "name": "codex-autopilot-kit",
  "version": "0.2.0",
  "description": "Safe project-scoped multi-agent autopilot for Codex with interactive setup, diff, doctor, and reusable Goal contracts",
  "type": "module",
  "bin": {
    "codex-autopilot": "./bin/codex-autopilot.mjs"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify-package.mjs",
    "doctor": "node bin/codex-autopilot.mjs doctor --target .",
    "release:check": "npm test && npm run verify && npm pack --dry-run",
    "prepublishOnly": "npm run release:check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "openai",
    "agents",
    "subagents",
    "multi-agent",
    "coding-agent",
    "autopilot",
    "cli",
    "goal",
    "agent-orchestration",
    "project-scoped"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crunaldo/codex-autopilot-kit.git"
  },
  "bugs": {
    "url": "https://github.com/crunaldo/codex-autopilot-kit/issues"
  },
  "homepage": "https://github.com/crunaldo/codex-autopilot-kit#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin/",
    "templates/",
    "docs/",
    "assets/",
    "install.ps1",
    "install.sh",
    "uninstall.ps1",
    "uninstall.sh",
    "LICENSE",
    "README.md",
    "README.es.md",
    "INSTALL_FOR_AGENTS.md",
    "llms.txt",
    "CHANGELOG.md"
  ]
}
